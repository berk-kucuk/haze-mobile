<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny all cleartext by default; only the loopback interface (embedded Tor
         SOCKS proxy + the local chat server) may use cleartext. Everything that
         leaves the device goes through Tor as an encrypted onion stream. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
